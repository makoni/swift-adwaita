// xcconfig for the swift-adwaita DemoApp Xcode example.
//
// Xcode's build system has no native pkg-config integration, so we have to
// list Homebrew's GTK4 / libadwaita / glib include and library paths
// explicitly. Mirror what `pkg-config --cflags --libs libadwaita-1
// gtksourceview-5` returns on Apple Silicon. For Intel Macs, sed s|/opt/
// homebrew|/usr/local|g.

// macOS deployment target is dictated by the Homebrew GTK4 / glib /
// libadwaita bottles we link against, not by anything in the Swift code.
// brew's Apple Silicon bottles are currently compiled with min-os = macOS
// 26.0 (gtk4, glib, gobject, gio, libadwaita, gtksourceview5, pango,
// harfbuzz, gdk-pixbuf, graphene, intl) and 15.0 (cairo, cairo-gobject).
// Declaring anything lower here makes the linker emit a warning per
// dylib ("building for macOS-13.5, but linking with dylib ... which was
// built for newer version 26.0") and produces a binary whose declared
// LC_BUILD_VERSION lies about what it can actually run on — the dylib
// chain still demands 26.0 at load time. Honest deployment target = the
// floor of what brew shipped at build time. Bump in lockstep with
// `brew update && brew upgrade` if those bottles get rebuilt for a
// different macOS minimum.
MACOSX_DEPLOYMENT_TARGET = 26.0

// Match the Swift tools-version declared in `Package.swift`.
SWIFT_VERSION = 6.0

// Run from `main.swift`, no storyboard / @main App.
INFOPLIST_FILE = Info.plist
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_KEY_NSMainStoryboardFile =
INFOPLIST_KEY_NSPrincipalClass = NSApplication

// libadwaita uses dlopen at runtime (e.g. for GModule plugins) and links
// against arbitrary Homebrew dylibs. App Sandbox + Hardened Runtime would
// block that without a wide set of entitlements, which is overkill for a
// developer example. For App Store / notarized distribution, re-enable both
// and add the `com.apple.security.cs.disable-library-validation` /
// `disable-executable-page-protection` entitlements.
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = NO

// Homebrew install prefix on Apple Silicon.
HOMEBREW_PREFIX = /opt/homebrew

// Headers — the union of what `pkg-config --cflags libadwaita-1
// gtksourceview-5` produces. Listed verbosely so contributors can see what
// each path is for; Xcode happily merges duplicates.
HEADER_SEARCH_PATHS = $(inherited) \
    $(HOMEBREW_PREFIX)/include \
    $(HOMEBREW_PREFIX)/include/libadwaita-1 \
    $(HOMEBREW_PREFIX)/include/gtk-4.0 \
    $(HOMEBREW_PREFIX)/include/gtksourceview-5 \
    $(HOMEBREW_PREFIX)/include/glib-2.0 \
    $(HOMEBREW_PREFIX)/lib/glib-2.0/include \
    $(HOMEBREW_PREFIX)/include/pango-1.0 \
    $(HOMEBREW_PREFIX)/include/cairo \
    $(HOMEBREW_PREFIX)/include/gdk-pixbuf-2.0 \
    $(HOMEBREW_PREFIX)/include/graphene-1.0 \
    $(HOMEBREW_PREFIX)/lib/graphene-1.0/include \
    $(HOMEBREW_PREFIX)/include/harfbuzz \
    $(HOMEBREW_PREFIX)/include/fribidi \
    $(HOMEBREW_PREFIX)/include/appstream

LIBRARY_SEARCH_PATHS = $(inherited) $(HOMEBREW_PREFIX)/lib

// Linker flags — the libraries declared in `Sources/CAdwaita/module.modulemap`
// and `Sources/CGtkSource/module.modulemap`. Without these, Swift sees the
// modules but the final link fails on undefined `gtk_*` / `adw_*` symbols.
OTHER_LDFLAGS = $(inherited) \
    -ladwaita-1 \
    -lgtk-4 \
    -lgtksourceview-5 \
    -lgobject-2.0 \
    -lglib-2.0 \
    -lgio-2.0 \
    -lgdk_pixbuf-2.0
